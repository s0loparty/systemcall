APP_NAME=Systemcall
APP_ENV=local
APP_KEY=base64:seIiB3mYvfRbcdm8pkdleIfF+EnxWpupz1p0yQ2I9Cg=
APP_DEBUG=true
APP_URL=http://localhost

# Local smoke stack: Laravel Sail + Reverb + LiveKit.
# Copy this file to .env before running Sail:
# cp .env.local.test .env
SAIL_FILES=compose.sail.yaml:compose.sail-livekit.yaml
APP_SERVICE=laravel.test
APP_PORT=80
VITE_PORT=5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=5432

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=host.docker.internal
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_ID=local-app
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_SCALING_ENABLED=false
REVERB_LOCAL_PORT=8080

VITE_REVERB_APP_KEY=local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# compose.sail-livekit.yaml reads LOCAL_* so production-like variables in
# .env.example cannot accidentally leak into the local smoke stack.
LOCAL_REVERB_HOST=host.docker.internal
LOCAL_REVERB_PORT=8080
LOCAL_REVERB_SCHEME=http
LOCAL_REVERB_PUBLIC_HOST=localhost
LOCAL_REVERB_PUBLIC_PORT=8080
LOCAL_REVERB_PUBLIC_SCHEME=http
LOCAL_REVERB_APP_ID=local-app
LOCAL_REVERB_APP_KEY=local-key
LOCAL_REVERB_APP_SECRET=local-secret
LOCAL_VITE_REVERB_HOST=localhost
LOCAL_VITE_REVERB_PORT=8080
LOCAL_VITE_REVERB_SCHEME=http

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=local-livekit-secret-local-livekit-secret
LIVEKIT_TOKEN_TTL=3600
LIVEKIT_LOCAL_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT_RANGE=50000-50020
LIVEKIT_TURN_UDP_PORT=3478
LIVEKIT_TURN_ENABLED=true
LIVEKIT_USE_EXTERNAL_IP=false
LIVEKIT_NODE_IP=127.0.0.1

LOCAL_LIVEKIT_URL=ws://localhost:7880
LOCAL_LIVEKIT_API_KEY=devkey
LOCAL_LIVEKIT_API_SECRET=local-livekit-secret-local-livekit-secret

VIDEO_CALL_WAITING_ROOM_STALE_MINUTES=30

VITE_APP_NAME="${APP_NAME}"
